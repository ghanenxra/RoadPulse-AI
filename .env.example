# RoadPulse AI — Environment Variables

# Backend
DATABASE_URL=sqlite:///./roadpulse.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reports
REPORTS_DIR=./reports
UPLOADS_DIR=./uploads

# Scoring Weights (0-1, must sum to 1.0)
SCORING_WEIGHT_SEVERITY=0.40
SCORING_WEIGHT_DENSITY=0.25
SCORING_WEIGHT_TREND=0.20
SCORING_WEIGHT_CONTEXT=0.15
