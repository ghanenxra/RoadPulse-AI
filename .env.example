# ─────────────────────────────────────────────────────────────────────────────
# RoadPulse AI — Environment Variables
# Copy this file to .env and set values for your deployment.
# Only this file needs to change between environments (local / staging / prod).
# ─────────────────────────────────────────────────────────────────────────────

# ── App Environment ───────────────────────────────────────────────────────────
# 'development' → prints config on startup, verbose logs
# 'production'  → silent startup, no config dump
APP_ENV=development

# ── Backend Server ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default — no setup needed):
DATABASE_URL=sqlite:////absolute/path/to/backend/roadpulse.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/roadpulse

# Railway / Render automatically provide DATABASE_URL — leave blank to use it:
# DATABASE_URL=

# ── File Storage ──────────────────────────────────────────────────────────────
# Relative paths resolve from project root. Absolute paths used as-is.
UPLOADS_DIR=./uploads
REPORTS_DIR=./reports

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of EXTRA allowed origins (localhost is always allowed).
# Add your deployed frontend URL here:
CORS_ORIGINS=https://road-pulse-ai-mu.vercel.app

# Regex for wildcard CORS matching (e.g. all Vercel preview URLs):
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Road Health Scoring Weights ───────────────────────────────────────────────
# Must sum to 1.0. Tune per deployment without changing code.
SCORING_WEIGHT_SEVERITY=0.40
SCORING_WEIGHT_DENSITY=0.25
SCORING_WEIGHT_TREND=0.20
SCORING_WEIGHT_CONTEXT=0.15
